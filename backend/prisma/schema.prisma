generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int                 @id @default(autoincrement())
  name           String
  email          String              @unique
  passwordHash   String?
  googleId       String?             @unique
  facebookId     String?             @unique
  projects       Project[]
  refreshTokens  RefreshToken[]
  oauthExchanges OAuthExchangeCode[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  role           UserRole            @default(USER)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  tokenHash String
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthExchangeCode {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  expenses    Expense[]
  revenues    Revenue[]
  documents   Document[]
  materials   Material[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Expense {
  id             Int               @id @default(autoincrement())
  description    String
  category       String?
  amount         Float
  vatAmount      Float?
  date           DateTime          @default(now())
  supplier       String?
  documentNumber String?
  documentUrl    String?
  currency       String?
  paymentMethod  String?
  source         TransactionSource @default(MANUAL)
  projectId      Int
  documentId     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([documentId])
}

model Revenue {
  id             Int               @id @default(autoincrement())
  description    String
  customer       String?
  amount         Float
  vatAmount      Float?
  date           DateTime          @default(now())
  status         RevenueStatus     @default(PENDING)
  documentNumber String?
  documentUrl    String?
  currency       String?
  paymentMethod  String?
  source         TransactionSource @default(MANUAL)
  projectId      Int
  documentId     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([documentId])
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Float
  unitPrice Float
  supplier  String?
  projectId Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Document {
  id           Int      @id @default(autoincrement())
  name         String
  originalName String
  url          String
  storageKey   String
  mimeType     String
  size         Int
  projectId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses Expense[]
  revenues Revenue[]

  @@index([projectId])
  @@unique([storageKey])
}

enum UserRole {
  USER
  ADMIN
}

enum RevenueStatus {
  PENDING
  PAID
  CANCELLED
}

enum TransactionSource {
  MANUAL
  SCANNED
  IMPORTED
}

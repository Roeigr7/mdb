generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  projects      Project[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(USER)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  tokenHash String
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  expenses    Expense[]
  revenues    Revenue[]
  documents   Document[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Expense {
  id          Int      @id @default(autoincrement())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   Int
  description String
  amount      Float
  date        DateTime @default(now())
  category    String?
  createdAt   DateTime @default(now())
}

model Revenue {
  id          Int      @id @default(autoincrement())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   Int
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  materials Material[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id         Int      @id @default(autoincrement())
  name       String
  quantity   Float
  unitPrice  Float
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Document {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId Int
  createdAt DateTime @default(now())
}

enum UserRole {
  USER
  ADMIN
}
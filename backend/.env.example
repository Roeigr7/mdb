# =============================================================================
# Development (.env) — local app against mbd_dashboard
# =============================================================================
# Copy this file to `.env` and fill in real local values.
# Never commit `.env`.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mbd_dashboard
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional: local frontend origin for OAuth redirects and CORS (comma-separated for CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional: Google OAuth (leave empty until credentials are created)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional: Facebook OAuth (leave empty until credentials are created)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Optional: Nest Observe telemetry (https://observe.nestjs.com)
# Leave empty locally to disable Observe. Do not invent credentials.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=backend

# Document scan providers
# mock = deterministic local stubs (default for tests / offline)
# ollama = free local vision AI via Ollama (no paid API)
DOCUMENT_AI_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
# When DOCUMENT_AI_PROVIDER=ollama (or OCR_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Vision models can be slow on first load (cold start)
OLLAMA_TIMEOUT_MS=300000
# Optional local upload directory (defaults to backend/uploads)
# DOCUMENT_STORAGE_PATH=

# =============================================================================
# E2E / Test (.env.e2e) — isolated mbd_dashboard_test only
# =============================================================================
# Copy the E2E URL into `.env.e2e` (or set E2E_DATABASE_URL in CI).
# E2E setup always forces DATABASE_URL = E2E_DATABASE_URL so development
# mbd_dashboard is never used by tests.
#
# Preferred: Docker Compose (docker-compose.e2e.yml) on host port 5433
E2E_DATABASE_URL=postgresql://mbd_test:mbd_test@localhost:5433/mbd_dashboard_test

# Fallback (no Docker): create an isolated DB on the same Postgres server:
#   npm run test:e2e:db:bootstrap-local
# which writes .env.e2e with a URL pointing at mbd_dashboard_test.

# =============================================================================
# Production — see .env.production.example
# =============================================================================
# Production secrets must come from the deployment platform / GitHub Environments,
# never from committed files.

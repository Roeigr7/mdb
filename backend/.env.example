# Development — do NOT use this URL for E2E
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mbd_dashboard
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000

# E2E — dedicated database only (never point at mbd_dashboard)
# Preferred: Docker Compose (docker-compose.e2e.yml) on host port 5433
E2E_DATABASE_URL=postgresql://mbd_test:mbd_test@localhost:5433/mbd_dashboard_test

# Fallback (no Docker): create an isolated DB on the same Postgres server, e.g.
#   node ./scripts/bootstrap-local-e2e-db.mjs
# which writes .env.e2e with:
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mbd_dashboard_test

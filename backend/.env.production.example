# Production environment template — placeholders only.
# NEVER commit real production secrets.
#
# Configure actual values via your deployment platform / secret manager, e.g.:
#   GitHub → Settings → Environments → production → Secrets / Variables
#
# Do NOT use:
#   - localhost / 127.0.0.1
#   - mbd_dashboard_test (E2E/test database)
#   - the local development DATABASE_URL

# Required: production PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/mbd_dashboard

# Required: long, random secret used to sign JWTs (access + refresh)
JWT_SECRET=replace-with-a-long-random-production-secret

# Required: access-token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Required: refresh-token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# Optional: HTTP port (platform may inject PORT automatically)
PORT=3000

# Optional but recommended for production safeguards in env validation
NODE_ENV=production

# Frontend URL used for OAuth browser redirects (no trailing slash)
FRONTEND_URL=https://app.example.com

# Comma-separated allowed CORS origins for the SPA
CORS_ORIGIN=https://app.example.com

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback

# Optional: Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.example.com/auth/facebook/callback

# Optional: Nest Observe telemetry (https://observe.nestjs.com)
# Set real credentials from the Observe dashboard only — never invent keys.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=backend

# Document scan providers — use mock in CI; ollama for local free AI
DOCUMENT_AI_PROVIDER=mock
OCR_PROVIDER=mock
EXTRACTION_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

